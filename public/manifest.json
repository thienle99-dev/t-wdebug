{
  "manifest_version": 3,
  "name": "Debug Lens",
  "version": "0.1.0",
  "description": "Inspect page UI, network requests, console, and performance signals locally from Chrome.",
  "minimum_chrome_version": "120",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "permissions": ["storage", "scripting", "activeTab"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["capture/hook-bridge.js", "capture/ui-inspector.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "background": { "service_worker": "assets/service-worker.js", "type": "module" },
  "action": { "default_title": "Debug Lens", "default_popup": "popup.html", "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" } },
  "devtools_page": "devtools.html"
}
